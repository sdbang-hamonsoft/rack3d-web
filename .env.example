# Copy this file to .env and add your Tripo API key.
TRIPO_API_KEY=tsk_your_api_key_here

# ── 개발 서버(vite) 전용 설정 — 빌드 산출물에는 들어가지 않는다 ──────────────
# `/api` 프록시 대상 netis-fms 오리진. 미지정 시 https://fms.burunet.co.kr
# (호스트 주소는 시크릿이 아니다. 계정·토큰은 여기에 넣지 말 것)
VITE_FMS_ORIGIN=https://fms.burunet.co.kr

# http://localhost 개발 서버에서 FMS 리프레시 쿠키(Secure 속성)가 저장되지 않아
# /api/auth/refresh 가 항상 401이 날 때만 1로 켠다. 개발 전용, 프로덕션 무관.
# VITE_DEV_RELAX_COOKIE=1
